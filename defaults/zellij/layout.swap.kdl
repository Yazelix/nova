swap_tiled_layout name="single_open" {
    ui min_panes=4 {
        pane split_direction="vertical" {
            pane size=32 borderless=true {
                plugin location="radar"
            }
            pane stacked=true {
                children;
            }
        }
    }
}

swap_tiled_layout name="single_closed" {
    ui min_panes=4 {
        pane split_direction="vertical" {
            pane size=1 borderless=true {
                plugin location="radar"
            }
            pane stacked=true {
                children;
            }
        }
    }
}

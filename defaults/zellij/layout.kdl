layout {
    pane_template name="top_bar" borderless=true {
        @bar@
    }

    pane_template name="bottom_hints" borderless=true {
        plugin location="nova_hints" {
            show_mode true
            mode_format " #[fg=#ef7a73,bold]{mode}  "
            mode_format_normal ""
            mode_format_tab " #[fg=#ef7a73,bold]TAB #[fg=#555b66]| "
            mode_format_pane " #[fg=#ef7a73,bold]PANE #[fg=#555b66]| "
            mode_format_resize " #[fg=#ef7a73,bold]RESIZE #[fg=#555b66]| "
            mode_format_scroll " #[fg=#ef7a73,bold]SCROLL #[fg=#555b66]| "
            mode_format_search " #[fg=#ef7a73,bold]SEARCH #[fg=#555b66]| "
            mode_format_enter_search " #[fg=#ef7a73,bold]SEARCH INPUT #[fg=#555b66]| "
            mode_format_rename_tab " #[fg=#ef7a73,bold]RENAME TAB #[fg=#555b66]| "
            mode_format_rename_pane " #[fg=#ef7a73,bold]RENAME PANE #[fg=#555b66]| "
            collapse_when_empty false
            group_modifiers true
            direction_keys "arrows"
            direction_keys_tab "letters"
            direction_keys_pane "letters"
            direction_keys_resize "letters"
            direction_keys_scroll "letters"
            direction_keys_search "letters"
            mod_alias_ctrl "C"
            mod_alias_alt "A"
            mod_alias_shift "S"
            modifier_format "#[fg=#ff5252,bg=#252a30] {modifier} "
            label_mode_session "sess."
            label_move_tab "move"
            "key_format_normal_=move" "#[fg=$key]hl/jk "
            label_fullscreen "full"
            label_mode_normal "back"
            label_locked_mode_normal "unlock"
            label_tab_go_to_tab ""
            label_tab_new_tab ""
            label_pane_new_pane "new"
            label_tab_close_tab ""
            label_tab_toggle_tab ""
            label_pane_close_pane "close"
            label_pane_embed ""
            label_pane_pin ""
            label_pane_toggle_focus ""
            label_pane_focus_last_pane ""
            label_pane_toggle_focus_no_ui_fullscreen ""
            label_scroll_scroll "scroll"
            label_scroll_half_page ""
            label_scroll_bottom ""
            label_scroll_scroll_to_previous_prompt ""
            label_scroll_scroll_to_next_prompt ""
            label_scroll_select_command_at_scroll_position ""
            label_scroll_copy_last_command_output ""
            label_search_scroll "scroll"
            label_search_search_down "next"
            label_search_search_up "prev"
            label_search_half_page ""
            label_search_bottom ""
            label_search_scroll_to_previous_prompt ""
            label_search_scroll_to_next_prompt ""
            label_search_select_command_at_scroll_position ""
            label_tab_mode_normal "normal"
            preferred_key_tab_normal "Esc"
            label_pane_mode_normal "normal"
            preferred_key_pane_normal "Esc"
            preferred_key_pane_new "n"
            preferred_key_pane_full "f"
            preferred_key_pane_float "w"
            label_resize_resize ""
            label_resize_increase "grow"
            label_resize_decrease "shrink"
            label_resize_mode_normal "normal"
            preferred_key_resize_normal "Esc"
            label_scroll_mode_normal "normal"
            preferred_key_scroll_normal "Esc"
            preferred_key_scroll_page "h,l"
            label_search_mode_normal "normal"
            preferred_key_search_normal "Esc"
            preferred_key_search_page "h,l"
            label_enter_search_mode_scroll "cancel"
            preferred_key_enter_search_cancel "Esc"
            label_rename_tab_mode_normal "save"
            preferred_key_rename_tab_save "Enter"
            label_rename_tab_undo_rename "cancel"
            label_rename_pane_mode_normal "save"
            preferred_key_rename_pane_save "Enter"
            label_rename_pane_undo_rename "cancel"
            hint_order "focus, =new, =close, search_down, search_up, =next, =prev, =scroll, page, half_page, detach, manager, mode_pane, mode_resize, mode_tab, mode_scroll, sess., =move, mode_locked, content_layout, go_to_tab, new_pane, menu, full, hints, sidebar, git, config, agent, *, back, normal, cancel"
            hint_precedence "tl"
            color_key "#ef7a73"
            key_format "#[fg=$key]{key} "
            desc_format "#[fg=#a0a6af]{desc}"
            hint_spacer " "
            hint_spacer_tab "#[fg=#555b66] | "
            hint_spacer_pane "#[fg=#555b66] | "
            hint_spacer_resize "#[fg=#555b66] | "
            hint_spacer_scroll "#[fg=#555b66] | "
            hint_spacer_search "#[fg=#555b66] | "
            hint_spacer_enter_search "#[fg=#555b66] | "
            hint_spacer_rename_tab "#[fg=#555b66] | "
            hint_spacer_rename_pane "#[fg=#555b66] | "
        }
    }

    tab_template name="ui" {
        top_bar size=1
        children
        bottom_hints name="bottom_hints" size=1
    }

    tab_template name="ui_no_hints" {
        top_bar size=1
        children
    }

    default_tab_template {
        top_bar size=1
        pane split_direction="vertical" {
            pane name="sidebar" size=32 borderless=false @sidebar@
            children
        }
        bottom_hints name="@bottomHintsStartTitle@" size=1
    }

    tab {
        pane name="yazi_picker" command="@yazi@" focus=true close_on_exit=true {
            args "--yzx-startup-picker"
        }
    }

    new_tab_template cwd="$HOME" {
        top_bar size=1
        pane split_direction="vertical" {
            pane name="sidebar" size=32 borderless=false @sidebar@
            pane name="yazi_picker" command="@yazi@" focus=true close_on_exit=true {
                args "--yzx-startup-picker"
            }
        }
        bottom_hints name="@bottomHintsStartTitle@" size=1
    }
}

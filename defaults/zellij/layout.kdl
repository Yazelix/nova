layout {
    pane_template name="top_bar" borderless=true {
        @bar@
    }

    pane_template name="bottom_hints" borderless=true {
        plugin location="nova_hints" {
            show_mode true
            mode_format "#[fg=#ef7a73,bold]{mode}  "
            mode_format_normal ""
            mode_format_tab "#[fg=#ef7a73,bold]TAB #[fg=#555b66]| "
            mode_format_pane "#[fg=#ef7a73,bold]PANE #[fg=#555b66]| "
            mode_format_enter_search "#[fg=#ef7a73,bold]SEARCH INPUT  "
            mode_format_rename_tab "#[fg=#ef7a73,bold]RENAME TAB  "
            mode_format_rename_pane "#[fg=#ef7a73,bold]RENAME PANE  "
            collapse_when_empty false
            group_modifiers true
            direction_keys "arrows"
            direction_keys_tab "letters"
            direction_keys_pane "letters"
            mod_alias_ctrl "C"
            mod_alias_alt "A"
            mod_alias_shift "S"
            modifier_format "#[fg=#ff5252,bg=#252a30] {modifier} "
            label_mode_session "sess."
            label_move_tab "move"
            "key_format_normal_=move" "#[fg=$key]hl/jk "
            label_fullscreen "full"
            label_mode_normal "back"
            label_locked_mode_normal "unlock"
            label_tab_go_to_tab ""
            label_tab_new_tab ""
            label_pane_new_pane "new"
            label_tab_close_tab ""
            label_tab_toggle_tab ""
            label_pane_close_pane "close"
            label_pane_embed ""
            label_pane_pin ""
            label_pane_toggle_focus ""
            label_pane_focus_last_pane ""
            label_pane_toggle_focus_no_ui_fullscreen ""
            label_scroll_scroll "scroll"
            label_search_scroll "scroll"
            label_tab_mode_normal "normal"
            preferred_key_tab_normal "Esc"
            label_pane_mode_normal "normal"
            preferred_key_pane_normal "Esc"
            preferred_key_pane_new "n"
            preferred_key_pane_full "f"
            preferred_key_pane_float "w"
            hint_order "focus, =new, =close, search_down, search_up, =scroll, page, half_page, detach, manager, mode_pane, mode_resize, mode_tab, mode_scroll, sess., =move, mode_locked, content_layout, go_to_tab, new_pane, menu, full, hints, sidebar, git, config, agent, *, back, normal"
            hint_precedence "tl"
            color_key "#ef7a73"
            key_format "#[fg=$key]{key} "
            desc_format "#[fg=#a0a6af]{desc}"
            hint_spacer " "
            hint_spacer_tab "#[fg=#555b66] | "
            hint_spacer_pane "#[fg=#555b66] | "
        }
    }

    tab_template name="ui" {
        top_bar size=1
        children
        bottom_hints name="bottom_hints" size=1
    }

    tab_template name="ui_no_hints" {
        top_bar size=1
        children
    }

    default_tab_template {
        top_bar size=1
        pane split_direction="vertical" {
            pane name="sidebar" size=32 borderless=false @sidebar@
            children
        }
        bottom_hints name="@bottomHintsStartTitle@" size=1
    }

    tab {
        pane name="yazi_picker" command="@yazi@" focus=true close_on_exit=true {
            args "--yzx-startup-picker"
        }
    }

    new_tab_template cwd="$HOME" {
        top_bar size=1
        pane split_direction="vertical" {
            pane name="sidebar" size=32 borderless=false @sidebar@
            pane name="yazi_picker" command="@yazi@" focus=true close_on_exit=true {
                args "--yzx-startup-picker"
            }
        }
        bottom_hints name="@bottomHintsStartTitle@" size=1
    }
}

 /// One rendered hint, kept separate so it can be dropped whole.
 struct HintPiece {
+    hint_index: usize,
     parts: Vec<ANSIString<'static>>,
     width: usize,
     group: HintGroup,
 }

+fn shared_modifiers(hint: &Hint, style: &HintStyle) -> Option<Vec<KeyModifier>> {
+    if hint_override(CONFIG_KEYS_PREFIX, hint, style.mode, style.config).is_some() {
+        return None;
+    }
+    let keys = filter_direction_keys(&hint.keys, style.direction_keys);
+    let modifiers = keys
+        .first()?
+        .key_modifiers
+        .iter()
+        .copied()
+        .collect::<Vec<_>>();
+    (!modifiers.is_empty()
+        && keys
+            .iter()
+            .all(|key| key.key_modifiers == keys[0].key_modifiers))
+    .then_some(modifiers)
+}
+
+fn render_pieces(pieces: &mut [HintPiece], hints: &[Hint], style: &HintStyle, grouped: bool) {
+    let mut previous = None;
+    for (index, piece) in pieces.iter_mut().enumerate() {
+        let hint = &hints[piece.hint_index];
+        let modifiers = grouped.then(|| shared_modifiers(hint, style)).flatten();
+        let mut parts = vec![];
+        if let Some(modifiers) = &modifiers {
+            if previous.as_ref() != Some(modifiers) {
+                if index > 0 {
+                    parts.push(Style::new().paint("   "));
+                }
+                let title = chord_alias(modifiers, style.config).unwrap_or_else(|| {
+                    modifiers
+                        .iter()
+                        .map(|modifier| modifier_display(*modifier, style.config))
+                        .collect::<Vec<_>>()
+                        .join("-")
+                });
+                if let Some(template) = style
+                    .config
+                    .get("modifier_format")
+                    .filter(|s| !s.is_empty())
+                {
+                    parts.extend(format::render_template(
+                        template,
+                        &[("modifier", &title)],
+                        style.config,
+                        style.dim,
+                    ));
+                } else {
+                    let fg = palette_match!(style.colors.ribbon_selected.base);
+                    let bg = palette_match!(style.colors.ribbon_selected.background);
+                    parts.push(
+                        Style::new()
+                            .fg(fg)
+                            .on(bg)
+                            .bold()
+                            .paint(format!(" {} + ", title)),
+                    );
+                }
+                parts.push(Style::new().paint(" "));
+            }
+        }
+        render_hint(&mut parts, hint, style, modifiers.is_some());
+        piece.width = visible_width(&parts, style.wide_ambiguous);
+        piece.parts = parts;
+        previous = modifiers;
+    }
+}
+
 fn visible_width(parts: &[ANSIString<'static>], wide_ambiguous: bool) -> usize {
     calculate_visible_length(&format!("{}", ANSIStrings(parts)), wide_ambiguous)
 }


+/// Join one modifier group's keys: single characters run together (`hjkl`),
+/// named keys keep a visible boundary (`ESC / ENTER`).
+fn compose_key_group(keys: &[String]) -> String {
+    if keys.iter().all(|key| key.chars().count() == 1) {
+        keys.concat()
+    } else {
+        keys.join(" / ")
+    }
+}

+/// Keys configured as `pipe_hint_<id>` whose binding is a pipe, alone or
+/// followed by a return to normal mode. They stand in for a curated action
+/// that a pipe now performs, keeping its position and label.
+fn configured_pipe_keys(
+    keymap: &[(KeyWithModifier, Vec<Action>)],
+    style: &HintStyle,
+    id: &str,
+) -> Vec<KeyWithModifier> {
+    let Some(chord) = style.config.get(&format!("pipe_hint_{id}")) else {
+        return Vec::new();
+    };
+    let Ok(target) = chord.parse::<KeyWithModifier>() else {
+        return Vec::new();
+    };
+    keymap
+        .iter()
+        .filter(|(key, actions)| {
+            *key == target
+                && matches!(
+                    actions.as_slice(),
+                    [Action::KeybindPipe { .. }] | [Action::KeybindPipe { .. }, TO_NORMAL]
+                )
+        })
+        .map(|(key, _)| key.clone())
+        .collect()
+}

+    #[test]
+    fn preferred_key_groups_require_every_binding_and_preserve_single_keys() {
+        let keys = vec![
+            (key(BareKey::Char('h')), vec![Action::PageScrollUp]),
+            (key(BareKey::Char('l')), vec![Action::PageScrollDown]),
+            (key(BareKey::PageUp), vec![Action::PageScrollUp]),
+            (key(BareKey::PageDown), vec![Action::PageScrollDown]),
+        ];
+        let preference = [("preferred_key_scroll_page", "h,l")];
+        assert_eq!(rendered(InputMode::Scroll, &keys, &preference), "hl page");
+        let mut aliases = preference.to_vec();
+        aliases.push(("key_alias_h", "previous"));
+        assert_eq!(
+            rendered(InputMode::Scroll, &keys, &aliases),
+            "previous / l page"
+        );
+        assert_eq!(
+            rendered(
+                InputMode::Scroll,
+                &keys,
+                &[("preferred_key_scroll_page", "h,h,l")]
+            ),
+            "hl page"
+        );
+        assert_eq!(
+            rendered(InputMode::Scroll, &keys[1..], &preference),
+            rendered(InputMode::Scroll, &keys[1..], &[])
+        );
+        assert_eq!(
+            rendered(
+                InputMode::Scroll,
+                &keys,
+                &[("preferred_key_scroll_page", "h,invalid")]
+            ),
+            rendered(InputMode::Scroll, &keys, &[])
+        );
+        let comma = vec![
+            (key(BareKey::Char(',')), vec![Action::PageScrollUp]),
+            (key(BareKey::Char('l')), vec![Action::PageScrollDown]),
+        ];
+        assert_eq!(
+            rendered(
+                InputMode::Scroll,
+                &comma,
+                &[("preferred_key_scroll_page", ",")]
+            ),
+            ", page"
+        );
+    }

+    fn tab_exit_preference_tracks_current_bindings_and_aliases() {
+        let keys = vec![
+            (key(BareKey::Esc), vec![TO_NORMAL]),
+            (key(BareKey::Enter), vec![TO_NORMAL]),
+            (ctrl('t'), vec![TO_NORMAL]),
+        ];
+        let config = [
+            ("label_tab_mode_normal", "normal"),
+            ("preferred_key_tab_normal", "Esc"),
+        ];
+        assert_eq!(rendered(InputMode::Tab, &keys, &config), "ESC normal");
+        let mut aliases = config.to_vec();
+        aliases.push(("key_alias_esc", "Cancel"));
+        assert_eq!(rendered(InputMode::Tab, &keys, &aliases), "Cancel normal");
+        let remapped = &keys[1..];
+        let fallback = rendered(InputMode::Tab, remapped, &config);
+        assert!(fallback.contains("ENTER"), "{fallback}");
+        assert!(!fallback.contains("ESC"), "{fallback}");
+        let pane = rendered(InputMode::Pane, &keys, &config);
+        assert!(pane.contains("ESC / ENTER"), "{pane}");
+    }
